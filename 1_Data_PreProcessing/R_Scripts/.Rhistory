library(dplyr)
# දත්ත වැඩි අගයේ සිට අඩුවට පෙළගස්වා rank එකක් ලබා දීම
gene_counts_df %>%
arrange(desc(count)) %>%
mutate(rank = row_number()) %>%
ggplot(aes(x = rank, y = count)) +
geom_line(color = "blue", size = 1) +
scale_y_log10() + # Y අක්ෂය ලඝුගණක පරිමාණයට හැරවීම
labs(title = "Rank-Abundance Curve (Knee Plot)",
x = "Gene Rank (Most Expressed to Least Expressed)",
y = "Gene Count (Log10 Scale)") +
theme_minimal()
ggplot(gene_counts_df, aes(x = log10(count + 1))) +
geom_density(fill = "purple", alpha = 0.5, color = "black") +
# උදාහරණයක් ලෙස count අගය 10 ට (log10(11) ට) අදාළව සීමාවක් පෙන්වීම
geom_vline(xintercept = log10(10 + 1), color = "red", linetype = "dashed", size = 1) +
labs(title = "Density Plot of Gene Counts",
x = "Log10(Count + 1)",
y = "Density") +
theme_minimal()
# දත්ත වැඩි අගයේ සිට අඩුවට පෙළගස්වා rank එකක් ලබා දීම
