library(GEOquery)
library(DESeq2)
library(limma)
library(dplyr)
library(ggplot2)
# lets import our dataset
g_data <- read.csv("../../DATASET/GSE150910_gene-level_count_file.csv", header = TRUE, sep = ",", row.names = 1)
gene_counts = apply(g_data, MARGIN= 1 , FUN=sum)
print(gene_counts)
type(gene_counts) # int - means this is a pairlist of integers and names. we can seperate them and make a datafreame
# lets make a dataframe with coulumns 'gene_name' and 'count'
gene_counts_df = data.frame(
gene_name = names(gene_counts),
count = as.numeric(gene_counts)
)
print(gene_counts_df) # better
hist(gene_counts_df)
hist(gene_counts_df[:,1])
hist(gene_counts_df['count'])
hist(as.numeric(gene_counts_df['count']))
hist(gene_counts_df$count)
hist(gene_counts_df$count)
hist(gene_counts_df$count, freq = FALSE)
hist(gene_counts_df$count, freq = FALSE, main = "hello")
hist(gene_counts_df$count, freq = FALSE)
# histogram drawing
print(min(gene_counts_df$count))
print(max(gene_counts_df$count))
hist(
gene_counts_df$count,
breaks = 10000,
main = "Gene Count Distribution",
xlab = "Count",
ylab = "Frequency"
)
library(ggplot2)
# Get min and max
min_val <- min(gene_counts_df$count)
max_val <- max(gene_counts_df$count)
# Create 10,000 equal-width bins
breaks <- seq(min_val, max_val, length.out = 10001)
# Count values in each bin
hist_data <- as.data.frame(table(
cut(gene_counts_df$count,
breaks = breaks,
include.lowest = TRUE)
))
colnames(hist_data) <- c("Range", "Count")
# Midpoint of each bin (for plotting)
hist_data$Midpoint <- (head(breaks, -1) + tail(breaks, -1)) / 2
# Plot
ggplot(hist_data, aes(x = Midpoint, y = Count)) +
geom_line() +
labs(
title = "Gene Count Distribution",
x = "Count Range",
y = "Frequency"
) +
theme_minimal()
