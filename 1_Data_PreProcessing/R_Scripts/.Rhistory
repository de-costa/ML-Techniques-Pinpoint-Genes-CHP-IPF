hist(
gene_counts_df$count,
breaks = 10000,
main = "Gene Count Distribution",
xlab = "Count",
ylab = "Frequency"
)
hist(
gene_counts_df$count,
breaks = 10,
main = "Gene Count Distribution",
xlab = "Count",
ylab = "Frequency"
)
# Base R මගින් Histogram සහ Normal Curve ඇඳීම
hist(gene_counts_df$count,
probability = TRUE,
breaks = 100,
col = "lightblue",
main = "Histogram with Normal Curve",
xlab = "Gene Counts")
# දත්තවල මධ්‍යන්‍යය (mean) සහ සම්මත අපගමනය (sd) ගණනය කිරීම
mean_val <- mean(gene_counts_df$count)
sd_val <- sd(gene_counts_df$count)
# Normal Curve එකක් එක් කිරීම
curve(dnorm(x, mean = mean_val, sd = sd_val),
add = TRUE,
col = "red",
lwd = 2)
library(ggplot2)
ggplot(gene_counts_df, aes(x = count + 1)) +
geom_histogram(bins = 100, fill = "steelblue", color = "black") +
scale_x_log10() + # X අක්ෂය ලඝුගණක පරිමාණයකට හැරවීම
labs(title = "Log10 Transformed Gene Counts",
x = "Gene Counts (Log10 scale, count + 1)",
y = "Frequency (Number of Genes)") +
theme_minimal()
